<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <MudText Typo="Typo.h5">Sign in to play.</MudText>
                <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Sign in</MudButton>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <MudText Typo="Typo.h5">That page is not in the library.</MudText>
            <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">Back to the shelf</MudButton>
        </LayoutView>
    </NotFound>
</Router>
