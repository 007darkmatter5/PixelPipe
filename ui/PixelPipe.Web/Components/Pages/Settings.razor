@page "/settings"
@attribute [Authorize]
@inject LibraryService Library
@inject EngineClient Engine
@inject UpdateService Updates
@inject IJSRuntime Js

<PageTitle>Settings · PixelPipe</PageTitle>

<MudText Typo="Typo.h4">Settings</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">This host, this library, this encoder.</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="0">
            <MudText Typo="Typo.h6">Library</MudText>
            <MudText Typo="Typo.body2">@Library.RomsPath</MudText>
            @if (!string.IsNullOrWhiteSpace(_unc))
            {
                <MudText Typo="Typo.caption">UNC @_unc</MudText>
            }
            <MudTextField @bind-Value="_roms" Label="ROM folder" HelperText="Type M:\Games\ROMs or \\server\share. Mapped drives are listed because this app runs as you, not as administrator." Class="mt-2" />
            <MudStack Row="true" Class="mt-2">
                <MudButton Variant="Variant.Outlined" OnClick="ShowDrives">Drives</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="UpFolder" Disabled="@(_browseParent is null)">Up</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRoms">Save and rescan</MudButton>
            </MudStack>
            @if (_folders is not null)
            {
                <MudList T="string" Dense="true" Class="mt-2">
                    @foreach (var folder in _folders)
                    {
                        <MudListItem T="string" OnClick="@(() => OpenFolder(folder.Path))">@folder.Name</MudListItem>
                    }
                </MudList>
            }
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Identification is the filename plus CRC32. Optional titles live in library.json.
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="0">
            <MudText Typo="Typo.h6">Engine</MudText>
            @if (_health is null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">Engine is not reachable at @Library.EngineUrl.</MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Success" Dense="true">
                    Online · @_health.Version · @(_health.EncoderLabel ?? _health.Encoder ?? "encoder unknown")
                </MudAlert>
                @if (!string.IsNullOrWhiteSpace(_health.EncoderDetail))
                {
                    <MudText Typo="Typo.body2">@_health.EncoderDetail</MudText>
                }
            }
            <MudText Typo="Typo.caption">Signaling @Library.EngineUrl. The browser uses @BrowserEngine().</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="0">
            <MudText Typo="Typo.h6">Updates</MudText>
            <MudText Typo="Typo.body2">Installed @_status.CurrentVersion. Latest: @(_status.LatestVersion ?? "unknown").</MudText>
            @if (!string.IsNullOrWhiteSpace(_status.Error))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@_status.Error</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(_status.ReleaseNotes))
            {
                <MudText Typo="Typo.body2" Class="mt-2" Style="white-space: pre-wrap;">@_status.ReleaseNotes</MudText>
            }
            <MudCheckBox T="bool" @bind-Value="_previews" Label="Include preview builds" Class="mt-2" />
            <MudTextField @bind-Value="_token" Label="GitHub token" InputType="InputType.Password" HelperText="Stored with Windows DPAPI for this user. Leave blank to keep the saved token. Never shown again." Class="mt-2" />
            <MudStack Row="true" Class="mt-2">
                <MudButton Variant="Variant.Outlined" OnClick="SaveUpdateSettings">Save</MudButton>
                <MudButton Variant="Variant.Text" OnClick="ClearToken">Clear token</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="CheckNow">Check now</MudButton>
                @if (_status.CanSelfUpdate && _status.UpdateAvailable)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UpdateNow">Update now</MudButton>
                }
            </MudStack>
            @if (!_status.CanSelfUpdate)
            {
                <MudText Typo="Typo.body2" Class="mt-2">This copy runs in Docker. When an update is listed, pull the new image: <code>docker compose pull &amp;&amp; docker compose up -d</code></MudText>
            }
            <MudText Typo="Typo.caption">@_status.Phase @( _status.TokenConfigured ? "· token saved" : "· no token")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="0">
            <MudText Typo="Typo.h6">Encoder probe</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Order: NVIDIA NVENC, Intel Quick Sync, VAAPI, AMD AMF, libx264.</MudText>
            @if (_encoders is null)
            {
                <MudText Typo="Typo.body2">Probe results appear when the engine is running.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr><th>Encoder</th><th>Status</th><th>Detail</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var probe in _encoders)
                    {
                        <tr>
                            <td>@probe.GetProperty("label").GetString()</td>
                            <td>@(probe.GetProperty("available").GetBoolean() ? "available" : "skipped")</td>
                            <td>@probe.GetProperty("detail").GetString()</td>
                        </tr>
                    }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="0">
            <MudText Typo="Typo.h6">Cores</MudText>
            @if (_cores is null)
            {
                <MudText Typo="Typo.body2">Core inventory appears when the engine is running.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true">
                    <thead><tr><th>System</th><th>File</th><th>Present</th></tr></thead>
                    <tbody>
                    @foreach (var core in _cores)
                    {
                        <tr>
                            <td>@core.GetProperty("system").GetString()</td>
                            <td><code>@core.GetProperty("file").GetString()</code></td>
                            <td>@(core.GetProperty("present").GetBoolean() ? "yes" : "missing")</td>
                        </tr>
                    }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    </MudItem>
    <AuthorizeView Roles="Admin">
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="0">
                <MudText Typo="Typo.h6">Remote play</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    The browser stays on this site. Signaling is proxied to the engine, and remote video uses TURN.
                    On the LAN, a direct connection is still preferred.
                </MudText>
                <MudCheckBox T="bool" @bind-Value="_behindProxy" Label="Behind a reverse proxy (honour X-Forwarded-Proto and X-Forwarded-For)" />
                <MudTextField @bind-Value="_publicUrl" Label="Public URL" HelperText="https://pixelpipe.lv426.cloud" Class="mt-2" />
                <MudText Typo="Typo.subtitle2" Class="mt-4">Cloudflare Realtime TURN</MudText>
                <MudText Typo="Typo.caption">@(_turnReady ? "A key is stored and will not be shown again." : "No Cloudflare TURN key stored.")</MudText>
                <MudTextField @bind-Value="_turnKey" Label="TURN key ID" Class="mt-2" />
                <MudTextField @bind-Value="_turnToken" Label="API token" InputType="InputType.Password" Class="mt-2" />
                <MudText Typo="Typo.subtitle2" Class="mt-4">Generic TURN</MudText>
                <MudTextField @bind-Value="_turnUrl" Label="TURN or TURNS URL" HelperText="turns:turn.example.com:443?transport=tcp" />
                <MudTextField @bind-Value="_turnUser" Label="Username" Class="mt-2" />
                <MudTextField @bind-Value="_turnPassword" Label="Credential" InputType="InputType.Password" HelperText="@(_turnPasswordReady ? "A credential is stored." : "")" Class="mt-2" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SaveRemote">Save remote access</MudButton>
            </MudPaper>
        </MudItem>
    </AuthorizeView>
</MudGrid>

@code {
    private EngineHealth? _health;
    private System.Text.Json.JsonElement[]? _encoders;
    private System.Text.Json.JsonElement[]? _cores;
    private UpdateSnapshot _status = new();
    private bool _previews = true;
    private string? _token;
    private string _roms = "";
    private string? _unc;
    private string? _browseParent;
    private RomFolder.Entry[]? _folders;
    private bool _behindProxy;
    private string _publicUrl = "";
    private string? _turnKey;
    private string? _turnToken;
    private string _turnUrl = "";
    private string _turnUser = "";
    private string? _turnPassword;
    private bool _turnReady;
    private bool _turnPasswordReady;

    protected override async Task OnInitializedAsync()
    {
        _status = Updates.Snapshot;
        _previews = _status.IncludePreviews;
        _roms = Library.RomsPath;
        _unc = RomFolder.TryUnc(_roms);
        var site = SiteSettings.Load();
        _behindProxy = site.BehindProxy;
        _publicUrl = site.PublicUrl;
        var secrets = SecretBox.Load();
        _turnReady = secrets.HasCloudflare;
        _turnPasswordReady = !string.IsNullOrEmpty(secrets.GenericCredential);
        _turnUrl = secrets.GenericUrl ?? "";
        _turnUser = secrets.GenericUsername ?? "";
        _health = await Engine.HealthAsync();
        var encoders = await Engine.GetAsync("api/encoders");
        if (encoders is { } doc && doc.TryGetProperty("probes", out var probes))
        {
            _encoders = probes.EnumerateArray().ToArray();
        }
        var cores = await Engine.GetAsync("api/cores");
        if (cores is { } coreDoc && coreDoc.ValueKind == System.Text.Json.JsonValueKind.Array)
        {
            _cores = coreDoc.EnumerateArray().ToArray();
        }
    }

    private string BrowserEngine() => Library.PublicEngineUrl ?? "the page host on port 9090";

    private void ShowDrives()
    {
        var listing = RomFolder.List(null);
        _folders = listing.Entries.ToArray();
        _browseParent = null;
    }

    private void OpenFolder(string path)
    {
        var listing = RomFolder.List(path);
        _roms = listing.Path ?? path;
        _unc = listing.Unc;
        _browseParent = listing.Parent;
        _folders = listing.Entries.ToArray();
    }

    private void UpFolder()
    {
        if (_browseParent is null)
        {
            ShowDrives();
            return;
        }

        OpenFolder(_browseParent);
    }

    private async Task SaveRoms()
    {
        if (string.IsNullOrWhiteSpace(_roms))
        {
            return;
        }

        var saved = RomFolder.Remember(_roms);
        _roms = saved.Path;
        _unc = saved.Unc;
        Library.UseRoms(saved.Path);
        Library.Get();
        await Engine.PostAsync("api/library/root", new { path = saved.Path });
    }

    private async Task SaveUpdateSettings()
    {
        Updates.SaveSettings(_previews, _token, clearToken: false);
        _token = null;
        await Updates.CheckAsync(CancellationToken.None);
        _status = Updates.Snapshot;
    }

    private async Task ClearToken()
    {
        Updates.SaveSettings(_previews, null, clearToken: true);
        _token = null;
        _status = Updates.Snapshot;
    }

    private async Task CheckNow()
    {
        await Updates.CheckAsync(CancellationToken.None);
        _status = Updates.Snapshot;
    }

    private async Task UpdateNow()
    {
        var confirm = await Js.InvokeAsync<bool>("confirm", "Install the update and restart PixelPipe on this computer?");
        if (!confirm)
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("pixelpipeApplyUpdate", true);
        }
        catch
        {
            _status = Updates.Snapshot;
        }
    }

    private void SaveRemote()
    {
        SiteSettings.Save(new SiteSettings { BehindProxy = _behindProxy, PublicUrl = _publicUrl ?? "" });
        var secrets = SecretBox.Load();
        if (!string.IsNullOrWhiteSpace(_turnKey))
        {
            secrets.CloudflareKeyId = _turnKey.Trim();
        }

        if (!string.IsNullOrWhiteSpace(_turnToken))
        {
            secrets.CloudflareToken = _turnToken.Trim();
        }

        secrets.GenericUrl = (_turnUrl ?? "").Trim();
        secrets.GenericUsername = (_turnUser ?? "").Trim();
        if (!string.IsNullOrWhiteSpace(_turnPassword))
        {
            secrets.GenericCredential = _turnPassword;
        }

        SecretBox.Save(secrets);
        _turnKey = null;
        _turnToken = null;
        _turnPassword = null;
        _turnReady = secrets.HasCloudflare;
        _turnPasswordReady = !string.IsNullOrEmpty(secrets.GenericCredential);
    }
}
