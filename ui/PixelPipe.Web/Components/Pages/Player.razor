@page "/play/{*Id}"
@attribute [Authorize]
@inject IJSRuntime JS
@inject LibraryService Library
@inject NavigationManager Nav

<PageTitle>@(_game?.Title ?? "Play") · PixelPipe</PageTitle>

@if (_game is null)
{
    <MudAlert Severity="Severity.Warning">That ROM is not in the library.</MudAlert>
}
else
{
    <div class="player-layout">
        <div>
            <div class="stage" id="pp-stage" tabindex="0">
                <video id="pp-video" autoplay playsinline></video>
                <div id="pp-hud" class="hud">Click Play. Arrows move, Z is B, X is A, Enter is Start, Shift is Select.</div>
            </div>
        </div>
        <aside class="player-side">
            <MudText Typo="Typo.h5">@_game.Title</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@_game.System · @_game.Crc32</MudText>
            <div class="row">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Start">Play</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="Save">Save slot @_slot</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="Load">Load slot @_slot</MudButton>
            </div>
            <MudButtonGroup Class="mt-2">
                @foreach (var slot in new[] { "1", "2", "3", "4", "5" })
                {
                    <MudButton Variant="@(_slot == slot ? Variant.Filled : Variant.Outlined)" OnClick="@(() => _slot = slot)">@slot</MudButton>
                }
            </MudButtonGroup>
            <MudText Typo="Typo.caption">
                Battery saves are written while you play and when you leave. Leaving also writes the auto slot, which Continue loads.
                Numbered slots are only yours.
            </MudText>
            <MudButton Href="@_game.DetailHref" Variant="Variant.Text" Class="mt-2">Details</MudButton>
        </aside>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    [SupplyParameterFromQuery(Name = "slot")] public string? SlotQuery { get; set; }
    private GameEntry? _game;
    private bool _freeze;
    private string _slot = "1";

    protected override void OnParametersSet()
    {
        _game = Library.Find(Uri.UnescapeDataString(Id));
        if (!string.IsNullOrWhiteSpace(SlotQuery))
        {
            _slot = SlotQuery;
        }
    }

    protected override bool ShouldRender() => !_freeze;

    private string EngineBase()
    {
        if (Library.PublicEngineUrl is { } configured)
        {
            return configured;
        }

        var uri = new Uri(Nav.BaseUri);
        var port = uri.Port is 80 or 443 ? "" : ":9090";
        if (uri.Port is not (80 or 443))
        {
            port = ":9090";
        }
        return $"{uri.Scheme}//{uri.Host}{port}";
    }

    private async Task Start()
    {
        if (_game is null || _freeze)
        {
            return;
        }

        _freeze = true;
        await JS.InvokeVoidAsync("pixelpipePlayer.start", new
        {
            rom = _game.RelativePath,
            engine = EngineBase(),
            slot = _slot,
        });
    }

    private async Task Save() => await JS.InvokeVoidAsync("pixelpipePlayer.saveState", _slot);

    private async Task Load() => await JS.InvokeVoidAsync("pixelpipePlayer.loadState", _slot);
}
