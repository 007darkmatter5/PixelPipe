@page "/play/{*Id}"
@attribute [Authorize]
@inject IJSRuntime JS
@inject LibraryService Library
@inject NavigationManager Nav

<PageTitle>@(_game?.Title ?? "Play") · PixelPipe</PageTitle>

@if (_game is null)
{
    <MudAlert Severity="Severity.Warning">That ROM is not in the library.</MudAlert>
}
else
{
    <div class="player-layout">
        <div>
            <div class="stage" id="pp-stage" tabindex="0">
                <video id="pp-video" autoplay playsinline></video>
                <button type="button" id="pp-menu-toggle" class="pp-menu-toggle" aria-label="Game menu">Menu</button>
                <div id="pp-menu" class="pp-menu">
                    <button type="button" class="pp-menu-backdrop" data-pp-action="close" aria-label="Close menu"></button>
                    <div id="pp-menu-panel" class="pp-menu-panel" role="dialog" aria-modal="true" aria-label="Game menu">
                        <p id="pp-menu-title" class="pp-menu-title">Menu</p>
                        <div id="pp-menu-main" class="pp-menu-page">
                            <button type="button" data-pp-action="resume">Resume</button>
                            <button type="button" data-pp-action="pause">Pause</button>
                            <button type="button" data-pp-action="save">Save state</button>
                            <button type="button" data-pp-action="load">Load state</button>
                            <button type="button" data-pp-action="reset">Reset game</button>
                            <button type="button" data-pp-action="fullscreen">Fullscreen</button>
                            <button type="button" data-pp-action="quit">Quit to library</button>
                        </div>
                        <div id="pp-menu-slots" class="pp-menu-page" hidden>
                            <button type="button" data-pp-slot="1">Slot 1</button>
                            <button type="button" data-pp-slot="2">Slot 2</button>
                            <button type="button" data-pp-slot="3">Slot 3</button>
                            <button type="button" data-pp-slot="4">Slot 4</button>
                            <button type="button" data-pp-slot="5">Slot 5</button>
                            <button type="button" data-pp-action="back">Back</button>
                        </div>
                        <div id="pp-menu-reset" class="pp-menu-page" hidden>
                            <button type="button" data-pp-action="reset-yes">Reset game</button>
                            <button type="button" data-pp-action="reset-no">Don't reset</button>
                        </div>
                    </div>
                </div>
                <div id="pp-paused" class="pp-paused" hidden>Paused</div>
                <div id="pp-hud" class="hud">Click Play. Arrows move, Z is B, X is A, Enter is Start, Shift is Select. Menu, Esc, or Select+Start opens the menu.</div>
            </div>
        </div>
        <aside class="player-side">
            <MudText Typo="Typo.h5">@_game.Title</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@_game.System · @_game.Crc32</MudText>
            <div class="row">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Start">Play</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="PauseGame">Pause</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="QuitGame">Quit to library</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="Save">Save slot @_slot</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="Load">Load slot @_slot</MudButton>
            </div>
            <MudButtonGroup Class="mt-2">
                @foreach (var slot in new[] { "1", "2", "3", "4", "5" })
                {
                    <MudButton Variant="@(_slot == slot ? Variant.Filled : Variant.Outlined)" OnClick="@(() => _slot = slot)">@slot</MudButton>
                }
            </MudButtonGroup>
            <MudText Typo="Typo.caption">
                The Menu button, Esc, or holding Select and Start opens the menu. Quit to library writes the auto slot, which Continue loads, and stops the game.
                Numbered slots are only yours. Closing this page does the same save.
            </MudText>
            <MudButton Href="@_game.DetailHref" Variant="Variant.Text" Class="mt-2">Details</MudButton>
        </aside>
    </div>
}

@implements IAsyncDisposable
@code {
    [Parameter] public string Id { get; set; } = "";
    [SupplyParameterFromQuery(Name = "slot")] public string? SlotQuery { get; set; }
    private GameEntry? _game;
    private bool _freeze;
    private string _slot = "1";

    protected override void OnParametersSet()
    {
        _game = Library.Find(Uri.UnescapeDataString(Id));
        if (!string.IsNullOrWhiteSpace(SlotQuery))
        {
            _slot = SlotQuery;
        }
    }

    protected override bool ShouldRender() => !_freeze;

    private string EngineBase()
    {
        if (Library.PublicEngineUrl is { } configured)
        {
            return configured;
        }

        var uri = new Uri(Nav.BaseUri);
        var port = uri.Port is 80 or 443 ? "" : ":9090";
        if (uri.Port is not (80 or 443))
        {
            port = ":9090";
        }
        return $"{uri.Scheme}//{uri.Host}{port}";
    }

    private async Task Start()
    {
        if (_game is null || _freeze)
        {
            return;
        }

        _freeze = true;
        await JS.InvokeVoidAsync("pixelpipePlayer.start", new
        {
            rom = _game.RelativePath,
            engine = EngineBase(),
            slot = _slot,
        });
    }

    private async Task Save() => await JS.InvokeVoidAsync("pixelpipePlayer.saveState", _slot);

    private async Task Load() => await JS.InvokeVoidAsync("pixelpipePlayer.loadState", _slot);

    private async Task PauseGame()
    {
        try
        {
            await JS.InvokeVoidAsync("pixelpipePlayer.togglePause");
        }
        catch (Exception)
        {
            // The overlay script reports the pause. This click still should not crash the page.
        }
    }

    private async Task QuitGame()
    {
        try
        {
            await JS.InvokeVoidAsync("pixelpipePlayer.quit");
        }
        catch (Exception)
        {
            Nav.NavigateTo("/");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("pixelpipePlayer.stop");
        }
        catch (JSDisconnectedException)
        {
            // The browser already left. The engine saves when the connection drops.
        }
        catch (InvalidOperationException)
        {
            // Prerender has no JavaScript runtime yet.
        }
    }
}
